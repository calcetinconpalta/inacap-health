<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: los datos de salud no salen del teléfono por respaldo ni por transferencia entre dispositivos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
