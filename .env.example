# =====================================================================
# INACAP Health · variables y secretos del proyecto
# Copia este archivo como ".env" (en la raíz) y completa los valores.
# ".env" está en .gitignore: NUNCA lo subas a git ni lo compartas por chat.
# =====================================================================

# ---------- Públicas por diseño (van dentro de la app y del panel) ----------
# Supabase → Project Settings → API Keys
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Firebase → Configuración del proyecto → Tus apps → Web
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
# Clave PÚBLICA de Bienestar para las derivaciones cifradas (la genera el panel)
BIENESTAR_CLAVE_PUBLICA=
# Dirección pública del panel (para el enlace de "olvidé mi contraseña")
PANEL_URL=https://inacap-health.pages.dev

# ---------- SECRETOS (solo en tu computador o en el gestor de secretos) ----------
# Nunca van en la app, en el panel ni en Cloudflare Pages.
# Supabase → Project Settings → API Keys → Secret key (salta TODAS las reglas de seguridad)
SUPABASE_SECRET_KEY=
# Supabase → Project Settings → Database → contraseña de la base (para psql / respaldos)
SUPABASE_DB_PASSWORD=
# Cloudflare → My Profile → API Tokens (permiso "Cloudflare Pages: Edit"), solo para desplegar con wrangler
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
